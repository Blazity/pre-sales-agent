# Local development template only.
# In deployed projects, set these values in Vercel Environment Variables.

# Core AI provider
ANTHROPIC_API_KEY=

# Slack app
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_OPS_CHANNEL_ID=

# Google Workspace OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GDRIVE_ROOT_FOLDER_ID=
# Generate these with: npm run setup:google-templates
GDRIVE_TEMPLATE_ID=
GSHEETS_TEMPLATE_ID=

# Knowledge base sources
GDRIVE_ESTIMATIONS_FOLDER_ID=
GDRIVE_PROPOSALS_FOLDER_ID=
CASE_STUDIES_BASE_URL=https://example.com

# Agency profile
AGENCY_PROFILE_PATH=config/agency.example.json
AGENCY_NAME=Example Digital Studio
AGENCY_ACCENT_COLOR=#F97316

# Pinecone and embeddings
PINECONE_API_KEY=
PINECONE_INDEX=estimations
VOYAGE_API_KEY=
VOYAGE_RPM=3

# Web research
BRAVE_SEARCH_API_KEY=

# Optional Figma integration
FIGMA_API_KEY=

# Agent workspace isolation
AGENT_WORKSPACE_PROVIDER=vercel-sandbox

# Vercel Sandbox template snapshot.
# Set these in Vercel Build environment variables to prebuild the agent workspace.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Git source for Vercel Sandbox.
# Required for private repos when creating the snapshot above, and for runtime
# git-clone fallback if no snapshot exists. Prefer AGENT_REPO_TOKEN; GITHUB_TOKEN
# is accepted as an alternative name.
AGENT_REPO_URL=
AGENT_REPO_REVISION=
AGENT_REPO_TOKEN=
GITHUB_TOKEN=
AGENT_REPO_USERNAME=

# App runtime
NODE_ENV=development
VERCEL_PROJECT_URL=

# Optional local test run
TEST_RFP_DOC_ID=
GDRIVE_OUTPUT_FOLDER_ID=
